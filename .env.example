# ===== FIREBASE =====
# Récupérer depuis : console.firebase.google.com > Projet > Paramètres > Vos applications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Notifications push web (Cloud Messaging > Web Push certificates dans la console Firebase)
VITE_FIREBASE_VAPID_KEY=

# ===== SUPABASE =====
# Récupérer depuis : supabase.com > Projet > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== GEMINI API (optionnel — assistant IA page contact) =====
# Récupérer depuis : aistudio.google.com > Get API Key (gratuit)
VITE_GEMINI_API_KEY=
